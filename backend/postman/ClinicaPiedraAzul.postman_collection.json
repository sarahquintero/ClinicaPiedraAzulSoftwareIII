              "raw": "{\n  \"pacienteId\": \"{{pacienteId}}\",\n  \"medicoId\": \"{{medicoId}}\",\n  \"fechaHora\": \"2026-11-25T10:00:00.000Z\",\n  \"duracionMinutos\": 30,\n  \"motivo\": \"Control general programado desde recepción.\"\n}"
