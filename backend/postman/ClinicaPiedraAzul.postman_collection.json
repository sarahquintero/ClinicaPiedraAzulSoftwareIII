{
  "info": {
    "name": "Clínica Piedra Azul — API Fase 1",
    "_postman_id": "9f6b1c8a-4e2d-4a91-b8c2-112233445566",
    "description": "Colección de verificación de contratos, JWT (401) y RBAC (403) para Clínica Piedra Azul.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "pacienteToken",
      "value": ""
    },
    {
      "key": "pacienteId",
      "value": ""
    },
    {
      "key": "medicoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Públicas",
      "item": [
        {
          "name": "Healthcheck",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Listar Médicos Activos (Público)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/medicos"
          }
        },
        {
          "name": "Verificar Cédula Ocupada (1020304050)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pacientes/verificar-cedula/1020304050"
          }
        },
        {
          "name": "Verificar Cédula Disponible (9999999999)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pacientes/verificar-cedula/9999999999"
          }
        }
      ]
    },
    {
      "name": "2. Autenticación JWT",
      "item": [
        {
          "name": "Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('adminToken', json.token);",
                  "pm.test('Status 200 y rol Administrador', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.user.role).to.eql('Administrador');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@piedraazul.com\",\n  \"password\": \"Admin123*\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('pacienteToken', json.token);",
                  "pm.test('Status 200 y rol Paciente', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(json.user.role).to.eql('Paciente');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"paciente@piedraazul.com\",\n  \"password\": \"Paciente123*\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "3. Pruebas de Seguridad (401 y 403)",
      "item": [
        {
          "name": "Ruta Privada Sin Token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Debe dar 401', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pacientes"
          }
        },
        {
          "name": "Paciente intentando ruta Admin -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Debe dar 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pacienteToken}}"
              }
            ],
            "url": "{{baseUrl}}/pacientes"
          }
        }
      ]
    },
    {
      "name": "4. Paciente",
      "item": [
        {
          "name": "Mis Citas (Solo propias)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pacienteToken}}"
              }
            ],
            "url": "{{baseUrl}}/citas/mis-citas"
          }
        }
      ]
    },
    {
      "name": "5. Administrador",
      "item": [
        {
          "name": "Listar Médicos (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "  pm.collectionVariables.set('medicoId', json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/medicos/admin"
          }
        },
        {
          "name": "Registrar Médico (Admin)",
          "request": {
