          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 sin token', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Devuelve un arreglo de médicos', () => { pm.expect(j.data).to.be.an('array'); pm.expect(j.data.length).to.be.above(0); });",
                  "pm.test('Cada médico tiene nombres y especialidad', () => j.data.forEach(m => { pm.expect(m).to.have.property('nombres'); pm.expect(m).to.have.property('especialidad'); }));"
                ]
              }
            }
          ]
