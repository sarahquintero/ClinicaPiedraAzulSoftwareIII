                  "if (json.token) pm.collectionVariables.set('adminToken', json.token);",
                  "pm.test('Status 200 y rol Administrador', () => { pm.response.to.have.status(200); pm.expect(json.token).to.be.a('string'); pm.expect(json.user.role).to.eql('Administrador'); });",
                  "pm.test('El token tiene estructura JWT (3 partes)', () => pm.expect(json.token.split('.')).to.have.lengthOf(3));"
                ]
              }
